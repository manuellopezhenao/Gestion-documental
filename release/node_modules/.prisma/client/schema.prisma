// Esquema objetivo descrito en ../PLAN_API.md seccion 4.
// Nota portabilidad (ver PLAN_API.md seccion 5): mientras el provider es
// "sqlite" no se usan anotaciones @db.VarChar/@db.Text especificas de motor,
// porque el conector de sqlite no las soporta. Al migrar a MySQL (cambiar
// `provider = "mysql"` y correr `prisma migrate dev` de nuevo) es el momento
// de agregar `@db.VarChar(n)` en cedula/consecutivo/nombre/etc. y
// `@@map` con charset utf8mb4 via el connection string
// (?charset=utf8mb4&collation=utf8mb4_unicode_ci).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Libro {
  id                  Int       @id @default(autoincrement())
  nombreArchivo       String    @map("nombre_archivo")
  rutaOrigen          String    @map("ruta_origen")
  periodoLibro        DateTime? @map("periodo_libro")
  totalPaginas        Int?      @map("total_paginas")
  documentosGenerados Int       @default(0) @map("documentos_generados")
  consecutivoMin      Int?      @map("consecutivo_min")
  consecutivoMax      Int?      @map("consecutivo_max")
  estado              String    @default("pendiente") // pendiente|procesando|completado|error
  errorDetalle        String?   @map("error_detalle")
  iniciadoEn          DateTime? @map("iniciado_en")
  finalizadoEn        DateTime? @map("finalizado_en")

  documentos Documento[]

  @@map("libros")
}

model Persona {
  id            Int      @id @default(autoincrement())
  cedula        String?  @unique
  nombre        String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  documentos Documento[]

  @@map("personas")
}

model Documento {
  id             Int       @id @default(autoincrement())
  libroId        Int?      @map("libro_id")
  libro          Libro?    @relation(fields: [libroId], references: [id])
  origen         String    @default("ocr") // "ocr" | "manual"
  personaId      Int?      @map("persona_id")
  persona        Persona?  @relation(fields: [personaId], references: [id])
  consecutivo    String
  consecutivoNum Int?      @map("consecutivo_num")
  fecha          DateTime?
  periodoLibro   DateTime? @map("periodo_libro")
  revisar        Boolean   @default(false)
  motivoRevisar  String?   @map("motivo_revisar")
  paginaInicio   Int       @map("pagina_inicio")
  paginaFin      Int       @map("pagina_fin")
  archivoPath    String    @map("archivo_path")
  tamanoBytes    Int?      @map("tamano_bytes")
  hashSha256     String?   @map("hash_sha256")
  procesadoEn    DateTime  @default(now()) @map("procesado_en")
  eliminadoEn    DateTime? @map("eliminado_en")

  @@index([consecutivoNum])
  @@index([fecha])
  @@index([personaId])
  @@index([libroId])
  @@index([revisar])
  @@index([eliminadoEn])
  @@map("documentos")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          String   @default("lector") // admin | editor | lector
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("usuarios")
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?     @map("usuario_id")
  accion      String // ver | descargar | editar | eliminar | subir_libro | subir_documento_manual
  documentoId Int?     @map("documento_id")
  detalle     String? // JSON con antes/despues si aplica
  fecha       DateTime @default(now())

  @@map("auditoria")
}
