# Copiar a .env y ajustar. Ver PLAN_API.md seccion 16.

# SQL Server. La base (ej. gestion_documental) tiene que existir; las tablas
# las crea "prisma migrate deploy". Variantes:
#   Usuario SQL:       sqlserver://HOST:1433;database=gestion_documental;user=sa;password=CLAVE;trustServerCertificate=true
#   SQL Express local: sqlserver://localhost\SQLEXPRESS;database=gestion_documental;user=sa;password=CLAVE;trustServerCertificate=true
#   Auth de Windows:   sqlserver://localhost:1433;database=gestion_documental;integratedSecurity=true;trustServerCertificate=true
# Si la clave tiene ; = { o } va entre llaves: password={mi;clave}
DATABASE_URL="sqlserver://localhost:1433;database=gestion_documental;user=sa;password=CAMBIAR;trustServerCertificate=true"

# Backend de almacenamiento de PDFs. Hoy solo existe "filesystem".
STORAGE_BACKEND=filesystem
# Carpeta donde ya vive la salida del pipeline OCR (split_facturas/output).
STORAGE_PATH=../split_facturas/output

# Secreto para firmar JWT. En prod: valor real, fuera del repo.
JWT_SECRET=cambia-este-valor-en-produccion
JWT_EXPIRA_MIN=60

# Usuario admin que crea/actualiza "prisma/seed.ts" (npm run prisma:seed,
# o automatico la primera vez que se corre "prisma migrate dev/reset" en
# una base nueva). Asi no hace falta mover el .db a mano a otra maquina.
ADMIN_EMAIL=femcentral@gmail.com
ADMIN_PASSWORD=Femcentral2026*

PORT=3000
LOG_LEVEL=debug

# Ruta al interprete y al script de OCR en Python (se mantiene tal cual,
# ver PLAN_API.md seccion 3 "decision Node/Python").
# Si se deja vacio/comentado, la API detecta sola entre "python3" y "python".
# PYTHON_BIN=python3
OCR_SCRIPT_PATH=../split_facturas/split_consecutivos.py
OCR_DB_PATH=../split_facturas/documentos.db
