// Esquema objetivo descrito en ../PLAN_API.md seccion 4.
// Motor: SQL Server. Prisma no permite leer el provider desde el .env, asi
// que cambiar de motor implica editar esta linea y regenerar migraciones;
// apuntar a OTRO SQL Server (local, de la red, Azure) es solo cambiar
// DATABASE_URL.
// Los String sin @db quedan como NVARCHAR(1000): se acotan los que tienen
// indice unico (SQL Server avisa si la clave puede pasar de 1700 bytes) y
// se abren a NVARCHAR(MAX) los que pueden ser largos (JSON de auditoria,
// stderr del OCR).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Libro {
  id                  Int       @id @default(autoincrement())
  nombreArchivo       String    @map("nombre_archivo")
  rutaOrigen          String    @map("ruta_origen")
  periodoLibro        DateTime? @map("periodo_libro")
  totalPaginas        Int?      @map("total_paginas")
  documentosGenerados Int       @default(0) @map("documentos_generados")
  consecutivoMin      Int?      @map("consecutivo_min")
  consecutivoMax      Int?      @map("consecutivo_max")
  estado              String    @default("pendiente") // pendiente|procesando|completado|error
  errorDetalle        String?   @map("error_detalle") @db.NVarChar(Max)
  iniciadoEn          DateTime? @map("iniciado_en")
  finalizadoEn        DateTime? @map("finalizado_en")

  documentos Documento[]

  @@map("libros")
}

model Persona {
  id            Int      @id @default(autoincrement())
  // OJO SQL Server: un UNIQUE admite un solo NULL. Hoy nunca se crea una
  // persona sin cedula (getOrCreatePersona devuelve null antes), mantenerlo asi.
  cedula        String?  @unique @db.NVarChar(50)
  nombre        String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  documentos Documento[]

  @@map("personas")
}

model Documento {
  id             Int       @id @default(autoincrement())
  libroId        Int?      @map("libro_id")
  libro          Libro?    @relation(fields: [libroId], references: [id])
  origen         String    @default("ocr") // "ocr" | "manual"
  personaId      Int?      @map("persona_id")
  persona        Persona?  @relation(fields: [personaId], references: [id])
  consecutivo    String
  consecutivoNum Int?      @map("consecutivo_num")
  fecha          DateTime?
  periodoLibro   DateTime? @map("periodo_libro")
  revisar        Boolean   @default(false)
  motivoRevisar  String?   @map("motivo_revisar")
  paginaInicio   Int       @map("pagina_inicio")
  paginaFin      Int       @map("pagina_fin")
  archivoPath    String    @map("archivo_path")
  tamanoBytes    Int?      @map("tamano_bytes")
  hashSha256     String?   @map("hash_sha256")
  procesadoEn    DateTime  @default(now()) @map("procesado_en")
  eliminadoEn    DateTime? @map("eliminado_en")

  @@index([consecutivoNum])
  @@index([fecha])
  @@index([personaId])
  @@index([libroId])
  @@index([revisar])
  @@index([eliminadoEn])
  @@map("documentos")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.NVarChar(255)
  passwordHash String   @map("password_hash")
  rol          String   @default("lector") // admin | editor | lector
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@map("usuarios")
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?     @map("usuario_id")
  accion      String // ver | descargar | editar | eliminar | subir_libro | subir_documento_manual
  documentoId Int?     @map("documento_id")
  detalle     String?  @db.NVarChar(Max) // JSON con antes/despues si aplica
  fecha       DateTime @default(now())

  @@map("auditoria")
}
